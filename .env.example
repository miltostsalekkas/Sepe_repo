# Copy this file to .env and fill in your own values.
# .env is ignored by git: never commit it.

# Your NIE / NIF, as you would type it on the SEPE form
SEPE_NIE=

# Postal code used to pick the SEPE office, e.g. 08014
SEPE_POSTAL_CODE=

# Telegram bot token from @BotFather, and the chat that receives the alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
